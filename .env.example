# ── Neon Database ──
DATABASE_URL=

# ── LLM ──
# Provide OPENROUTER_API_KEY to route through OpenRouter; otherwise falls back
# to direct Google Gemini via GOOGLE_GENAI_API_KEY.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GOOGLE_GENAI_API_KEY=

# ── GitHub (shared token — avoids 60 req/hr unauthenticated limit) ──
GITHUB_TOKEN=

# ── Better Auth (required for OAuth login) ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── OAuth providers (optional — enable for Google/GitHub login) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=