# ── Neon Database ──
DATABASE_URL=

# ── LLM ──
# OpenCode Go uses the OpenAI-compatible /v1/chat/completions API.
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=glm-5.3-flash
# Optional override, useful for testing with a compatible proxy.
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# OpenRouter is used first for LLM calls and for ingestion/query embeddings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# ── GitHub (shared token — avoids 60 req/hr unauthenticated limit) ──
GITHUB_TOKEN=

# ── Better Auth (required for OAuth login) ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── OAuth providers (optional — enable for Google/GitHub login) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
